<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/carRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Native Hardware Accelerated Video Player View (Zero lag, 60fps) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/carPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        android:visibility="gone" />

    <!-- In-Car WebView for browsing/searching -->
    <com.koy.auto.webview.KoYWebView
        android:id="@+id/carWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Container for Fullscreen Video Views -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />


    <!-- Floating Driver Control Bar (Bottom-left/Bottom-center) -->
    <LinearLayout
        android:id="@+id/floatingControlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_control_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_reload"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_fullscreen"
            android:src="@drawable/ic_fullscreen" />

        <ImageView
            android:id="@+id/ivAdBlockStatus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/adblock_active"
            android:src="@drawable/ic_shield" />
    </LinearLayout>

</FrameLayout>
